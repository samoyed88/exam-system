# 老師後台密碼（必填）
ADMIN_PASSWORD=change-me
# token 簽章用的隨機字串（必填），可用 python3 -c "import secrets;print(secrets.token_hex(32))" 產生
SECRET_KEY=replace-with-random-hex
# 取得學生真實 IP 的方式：cf = Cloudflare Tunnel、xff = Caddy 等反向代理、空白 = 直連
IP_HEADER=cf
# Cloudflare Tunnel 的 token（用 tunnel 模式時才需要）
TUNNEL_TOKEN=
# Caddy 模式使用的網域
DOMAIN=exam.example.com
# 本機對外的 port（只綁 127.0.0.1），未設定為 8000
APP_PORT=8000

# 新增管理員帳號時的預設密碼（第一次登入必須修改）
ADMIN_DEFAULT_PASSWORD=
